diff --git a/target/linux/bcm4908/base-files/lib/preinit/81_brcmfmac_nvram b/target/linux/bcm4908/base-files/lib/preinit/81_brcmfmac_nvram
new file mode 100644
index 0000000..50e9a61
--- /dev/null
+++ b/target/linux/bcm4908/base-files/lib/preinit/81_brcmfmac_nvram
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause
+
+brcmfmac_nvram_from_asus_data() {
+	local file mnt nvram
+
+	case "$(board_name)" in
+	asus,rt-ac86u)
+		file="/lib/firmware/brcm/brcmfmac4366c-pcie.asus,rt-ac86u.txt"
+		;;
+	*)
+		return
+		;;
+	esac
+
+	[ -s "$file" ] && return
+
+	mnt=$(mktemp -d) || return
+	if mount -t jffs2 -o ro mtd:data "$mnt"; then
+		nvram="$mnt/.kernel_nvram.setting"
+		if [ -s "$nvram" ]; then
+			mkdir -p "${file%/*}"
+			tr '\000' '\n' < "$nvram" | awk -F= '
+				/^devpath[0-9]+=pcie\/[0-9]+\/[0-9]+$/ {
+					split($2, path, "/")
+					printf "%s=pcie/%d/%s/\n", $1, path[2] + 1, path[3]
+					next
+				}
+				/^[0-9]+:/ { keys = keys $0 "\n" }
+				/^wl[0-9]+_leddc=/ {
+					radio = substr($1, 3, index($1, "_") - 3)
+					keys = keys radio ":leddc=" $2 "\n"
+				}
+				END { printf "%s", keys }
+			' > "$file"
+		fi
+		umount "$mnt"
+	fi
+	rmdir "$mnt"
+	[ -s "$file" ] || rm -f "$file"
+}
+
+boot_hook_add preinit_main brcmfmac_nvram_from_asus_data
