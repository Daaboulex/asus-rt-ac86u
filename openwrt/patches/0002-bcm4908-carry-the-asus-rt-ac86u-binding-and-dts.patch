diff --git a/target/linux/bcm4908/patches-6.18/090-dt-bindings-arm-bcmbca-add-ASUS-RT-AC86U.patch b/target/linux/bcm4908/patches-6.18/090-dt-bindings-arm-bcmbca-add-ASUS-RT-AC86U.patch
