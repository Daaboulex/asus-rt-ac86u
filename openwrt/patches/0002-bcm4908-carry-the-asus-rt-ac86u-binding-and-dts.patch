+
+---
+--- a/Documentation/devicetree/bindings/arm/bcm/brcm,bcmbca.yaml
++++ b/Documentation/devicetree/bindings/arm/bcm/brcm,bcmbca.yaml
+@@ -32,6 +32,7 @@
+       - description: BCM4906 based boards
+         items:
+           - enum:
++              - asus,rt-ac86u
+               - netgear,r8000p
+               - tplink,archer-c2300-v1
