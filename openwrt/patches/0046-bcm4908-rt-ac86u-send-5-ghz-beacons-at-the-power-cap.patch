+BEACON_BACKOFF_CLAMP_AT:=0x3a554
+BEACON_BACKOFF_CLAMP_WAS:=a3f11404
+BEACON_BACKOFF_CLAMP_IS:=\000\044\000\044
+
 define Download/rtecdc
   URL:=https://raw.githubusercontent.com/$(GPL_REPO)/$(GPL_COMMIT)/$(GPL_DONGLE)
   URL_FILE:=rtecdc.bin
@@ -31,18 +35,22 @@
   Broadcom's BCA dongle firmware for the BCM4366c0, build 10.10.131.116,
   the newest published access point build, from a mirror of Zyxel's
   DX5401-B0 GPL release. It hands SAE authentication to hostapd, so the
-  access points offer WPA3. It is installed under the board-specific name
+  access points offer WPA3. One instruction is changed so that beacons and
+  probe responses under a low transmit power cap go out at the cap instead
+  of at the largest backoff. It is installed under the board-specific name
   brcmfmac tries first, so other boards keep the linux-firmware build.
 endef
 
 define Build/Compile
-	true
+	cp $(DL_DIR)/$(PKG_NAME)-$(PKG_VERSION).bin $(PKG_BUILD_DIR)/rtecdc.bin
