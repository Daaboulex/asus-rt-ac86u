+	printf '$(BEACON_BACKOFF_CLAMP_IS)' | dd of=$(PKG_BUILD_DIR)/rtecdc.bin bs=1 seek=$$$$(($(BEACON_BACKOFF_CLAMP_AT))) conv=notrunc status=none
 endef
 
