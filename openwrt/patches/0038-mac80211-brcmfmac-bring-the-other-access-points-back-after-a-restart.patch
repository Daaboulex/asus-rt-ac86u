diff --git a/package/kernel/mac80211/patches/brcm/892-wifi-brcmfmac-bring-the-other-access-points-back-after-a-restart.patch b/package/kernel/mac80211/patches/brcm/892-wifi-brcmfmac-bring-the-other-access-points-back-after-a-restart.patch
new file mode 100644
index 0000000..0b38376
--- /dev/null
+++ b/package/kernel/mac80211/patches/brcm/892-wifi-brcmfmac-bring-the-other-access-points-back-after-a-restart.patch
@@ -0,0 +1,58 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] wifi: brcmfmac: bring the other access points back after a restart
+
+Starting the first access point of a radio takes the firmware down and
+up again with BRCMF_C_DOWN and BRCMF_C_UP to switch it to AP mode. When
+hostapd restarts that access point while a second one runs, for a
+setting change on reload, the second one stops beaconing: its bsscfg
+keeps its SSID and keys and still reads as up, but no beacon leaves the
+radio, so clients no longer find it while hostapd reports it enabled.
+
+After the first access point is set up, enable the bss of every other
+access point on the radio that is still started.
+
+---
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+@@ -5221,6 +5221,28 @@
+ 		brcmf_dbg(INFO, "vht_features 0x%x -> 0x%x\n", val, want);
+ }
+ 
++static void brcmf_cfg80211_reenable_mbss(struct brcmf_cfg80211_info *cfg,
++					 struct brcmf_if *ifp)
++{
++	struct brcmf_fil_bss_enable_le bss_enable;
++	struct brcmf_cfg80211_vif *vif;
++	s32 err;
++
++	list_for_each_entry(vif, &cfg->vif_list, list) {
++		if (vif == ifp->vif || !vif->mbss || !vif->ifp ||
++		    !test_bit(BRCMF_VIF_STATUS_AP_CREATED, &vif->sme_state))
++			continue;
++
++		bss_enable.bsscfgidx = cpu_to_le32(vif->ifp->bsscfgidx);
++		bss_enable.enable = cpu_to_le32(1);
++		err = brcmf_fil_iovar_data_set(ifp, "bss", &bss_enable,
++					       sizeof(bss_enable));
++		if (err < 0)
++			bphy_err(cfg->pub, "bss %d enable failed %d\n",
++				 vif->ifp->bsscfgidx, err);
++	}
++}
++
+ static s32
+ brcmf_cfg80211_start_ap(struct wiphy *wiphy, struct net_device *ndev,
+ 			struct cfg80211_ap_settings *settings)
+@@ -5424,6 +5446,12 @@
+ 			goto exit;
+ 		}
+ 
++		/* BRCMF_C_DOWN above stopped the other access points of
++		 * this radio; bring the ones still started back up
++		 */
++		if (!mbss)
++			brcmf_cfg80211_reenable_mbss(cfg, ifp);
++
+ 		brcmf_dbg(TRACE, "AP mode configuration complete\n");
+ 	} else if (dev_role == NL80211_IFTYPE_P2P_GO) {
+ 		err = brcmf_fil_iovar_int_set(ifp, "chanspec", chanspec);
