@@ -0,0 +1,52 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] dt-bindings: thermal: add brcm,bcm4908-thermal
+
+The CPU cluster of the BCM4908 family carries a temperature sensor read
+from one status register in the cluster's configuration block. Describe
+it as a thermal sensor.
+
+---
+--- /dev/null
++++ b/Documentation/devicetree/bindings/thermal/brcm,bcm4908-thermal.yaml
+@@ -0,0 +1,41 @@
++# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
++%YAML 1.2
++---
++$id: http://devicetree.org/schemas/thermal/brcm,bcm4908-thermal.yaml#
++$schema: http://devicetree.org/meta-schemas/core.yaml#
++
++title: Broadcom BCM4908 thermal sensor
++
++maintainers:
++  - Daaboulex <39669593+Daaboulex@users.noreply.github.com>
++
++description:
++  Temperature sensor of the CPU cluster in Broadcom BCM4908 family SoCs,
++  read from a status register in the cluster's configuration block.
++
++allOf:
++  - $ref: thermal-sensor.yaml#
++
++properties:
++  compatible:
++    const: brcm,bcm4908-thermal
++
++  reg:
++    maxItems: 1
++
++  "#thermal-sensor-cells":
++    const: 0
++
++required:
++  - compatible
++  - reg
++
++unevaluatedProperties: false
++
++examples:
++  - |
++    thermal-sensor@810621a0 {
++        compatible = "brcm,bcm4908-thermal";
++        reg = <0x810621a0 0x4>;
++        #thermal-sensor-cells = <0>;
++    };
diff --git a/target/linux/bcm4908/patches-6.18/815-thermal-broadcom-add-a-bcm4908-thermal-sensor-driver.patch b/target/linux/bcm4908/patches-6.18/815-thermal-broadcom-add-a-bcm4908-thermal-sensor-driver.patch
new file mode 100644
index 0000000..d893a3a
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/815-thermal-broadcom-add-a-bcm4908-thermal-sensor-driver.patch
@@ -0,0 +1,109 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] thermal: broadcom: add a BCM4908 thermal sensor driver
+
+The sensor's 10-bit reading sits at 0x810621a0, in the configuration
+block of the CPU cluster. Broadcom's GPL thermal driver in vendor
+firmware for these SoCs reads it there and converts it to millidegrees
+Celsius as (4133500 - 4906 * raw) / 10. Register it as a thermal zone
+sensor with the same conversion, and add the zone to hwmon as the other
+Broadcom thermal drivers do.
+
+---
+--- a/drivers/thermal/broadcom/Kconfig
++++ b/drivers/thermal/broadcom/Kconfig
+@@ -14,6 +14,15 @@ config BCM2835_THERMAL
+ 	help
+ 	  Support for thermal sensors on Broadcom bcm2835 SoCs.
+ 
++config BCM4908_THERMAL
++	tristate "Thermal sensor on BCM4908 family SoCs"
++	depends on ARCH_BCMBCA || COMPILE_TEST
++	depends on HAS_IOMEM
++	depends on THERMAL_OF
++	help
++	  Support for the temperature sensor of the CPU cluster in Broadcom
++	  BCM4908 family SoCs.
++
+ config BRCMSTB_THERMAL
+ 	tristate "Broadcom STB AVS TMON thermal driver"
+ 	depends on ARCH_BRCMSTB || COMPILE_TEST
+--- a/drivers/thermal/broadcom/Makefile
++++ b/drivers/thermal/broadcom/Makefile
+@@ -1,6 +1,7 @@
+ # SPDX-License-Identifier: GPL-2.0-only
+ obj-$(CONFIG_BCM2711_THERMAL)		+= bcm2711_thermal.o
+ obj-$(CONFIG_BCM2835_THERMAL)		+= bcm2835_thermal.o
++obj-$(CONFIG_BCM4908_THERMAL)		+= bcm4908_thermal.o
+ obj-$(CONFIG_BRCMSTB_THERMAL)		+= brcmstb_thermal.o
+ obj-$(CONFIG_BCM_NS_THERMAL)		+= ns-thermal.o
+ obj-$(CONFIG_BCM_SR_THERMAL)		+= sr-thermal.o
+--- /dev/null
++++ b/drivers/thermal/broadcom/bcm4908_thermal.c
+@@ -0,0 +1,67 @@
++// SPDX-License-Identifier: GPL-2.0-only
++
++#include <linux/bitfield.h>
++#include <linux/bits.h>
++#include <linux/err.h>
++#include <linux/io.h>
++#include <linux/mod_devicetable.h>
++#include <linux/module.h>
++#include <linux/platform_device.h>
++#include <linux/thermal.h>
++
++#include "../thermal_hwmon.h"
++
++#define BCM4908_THERMAL_RAW		GENMASK(9, 0)
++#define BCM4908_THERMAL_OFFSET_DECI_MC	4133500
++#define BCM4908_THERMAL_SLOPE_DECI_MC	4906
++
++static int bcm4908_thermal_get_temp(struct thermal_zone_device *tz, int *temp)
++{
++	void __iomem *reg = thermal_zone_device_priv(tz);
++	int raw = FIELD_GET(BCM4908_THERMAL_RAW, readl(reg));
++
++	*temp = (BCM4908_THERMAL_OFFSET_DECI_MC - BCM4908_THERMAL_SLOPE_DECI_MC * raw) / 10;
++	return 0;
++}
++
++static const struct thermal_zone_device_ops bcm4908_thermal_ops = {
++	.get_temp = bcm4908_thermal_get_temp,
++};
++
++static int bcm4908_thermal_probe(struct platform_device *pdev)
++{
++	struct device *dev = &pdev->dev;
++	struct thermal_zone_device *tz;
++	void __iomem *reg;
++
++	reg = devm_platform_ioremap_resource(pdev, 0);
++	if (IS_ERR(reg))
++		return PTR_ERR(reg);
++
++	tz = devm_thermal_of_zone_register(dev, 0, reg, &bcm4908_thermal_ops);
++	if (IS_ERR(tz))
++		return dev_err_probe(dev, PTR_ERR(tz), "failed to register the thermal zone\n");
++
++	if (devm_thermal_add_hwmon_sysfs(dev, tz))
++		dev_warn(dev, "failed to add hwmon sysfs attributes\n");
++
++	return 0;
++}
++
++static const struct of_device_id bcm4908_thermal_of_match[] = {
++	{ .compatible = "brcm,bcm4908-thermal" },
++	{ }
++};
++MODULE_DEVICE_TABLE(of, bcm4908_thermal_of_match);
++
++static struct platform_driver bcm4908_thermal_driver = {
++	.probe = bcm4908_thermal_probe,
++	.driver = {
++		.name = "bcm4908-thermal",
++		.of_match_table = bcm4908_thermal_of_match,
++	},
++};
++module_platform_driver(bcm4908_thermal_driver);
++
++MODULE_DESCRIPTION("Broadcom BCM4908 thermal sensor driver");
++MODULE_LICENSE("GPL");
diff --git a/target/linux/bcm4908/patches-6.18/318-arm64-dts-broadcom-bcmbca-bcm4908-add-the-cpu-thermal-sensor.patch b/target/linux/bcm4908/patches-6.18/318-arm64-dts-broadcom-bcmbca-bcm4908-add-the-cpu-thermal-sensor.patch
new file mode 100644
index 0000000..61b8d74
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/318-arm64-dts-broadcom-bcmbca-bcm4908-add-the-cpu-thermal-sensor.patch
@@ -0,0 +1,43 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] arm64: dts: broadcom: bcmbca: bcm4908: add the CPU thermal sensor
+
+The CPU thermal sensor sits in the cluster's configuration block at
+0x81060000, beyond the window of the axi bus, which ends after the GIC.
+Widen the window to cover that block, describe the sensor and give it a
+cpu-thermal zone. The zone has no trip points: the vendor driver's
+throttling and shutdown temperatures are not documented for this SoC,
+and a trip without a cooling device would act on one misread value.
+
+---
+--- a/arch/arm64/boot/dts/broadcom/bcmbca/bcm4908.dtsi
++++ b/arch/arm64/boot/dts/broadcom/bcmbca/bcm4908.dtsi
+@@ -82,7 +82,7 @@
+ 		compatible = "simple-bus";
+ 		#address-cells = <1>;
+ 		#size-cells = <1>;
+-		ranges = <0x00 0x00 0x81000000 0x4000>;
++		ranges = <0x00 0x00 0x81000000 0x64000>;
+ 
+ 		gic: interrupt-controller@1000 {
+ 			compatible = "arm,gic-400";
+@@ -92,6 +92,20 @@
+ 			reg = <0x1000 0x1000>,
+ 			      <0x2000 0x2000>;
+ 		};
++
++		cpu_thermal_sensor: thermal-sensor@621a0 {
++			compatible = "brcm,bcm4908-thermal";
++			reg = <0x621a0 0x4>;
++			#thermal-sensor-cells = <0>;
++		};
++	};
++
++	thermal-zones {
++		cpu-thermal {
++			polling-delay-passive = <0>;
++			polling-delay = <0>;
++			thermal-sensors = <&cpu_thermal_sensor>;
++		};
+ 	};
+ 
+ 	timer {
