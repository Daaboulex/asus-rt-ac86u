diff --git a/package/kernel/mac80211/patches/brcm/884-wifi-brcmfmac-apply-a-transmit-power-set-before-bring-up.patch b/package/kernel/mac80211/patches/brcm/884-wifi-brcmfmac-apply-a-transmit-power-set-before-bring-up.patch
new file mode 100644
index 0000000..3c7e732
--- /dev/null
+++ b/package/kernel/mac80211/patches/brcm/884-wifi-brcmfmac-apply-a-transmit-power-set-before-bring-up.patch
@@ -0,0 +1,117 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] wifi: brcmfmac: apply a transmit power set before bring-up
+
+OpenWrt's wifi scripts set the transmit power on the phy before they
+bring its interface up. brcmfmac refused that with -EIO because the
+primary interface was not ready yet, so a configured limit never
+reached the firmware after a boot and the radios kept their uncapped
+targets.
+
+Keep the requested power. Send it to the firmware at once when the
+primary interface is up, and again whenever that interface comes up.
+A failure to send it at bring-up is logged and does not fail the
+bring-up.
+
+---
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.h
+@@ -354,6 +354,8 @@
+  * @ibss_starter: indicates this sta is ibss starter.
+  * @pwr_save: indicate whether dongle to support power save mode.
+  * @dongle_up: indicate whether dongle up or not.
++ * @tx_power_set: a transmit power was requested since probe.
++ * @tx_power_qdbm: the requested transmit power, as sent in qtxpower.
+  * @roam_on: on/off switch for dongle self-roaming.
+  * @scan_tried: indicates if first scan attempted.
+  * @dcmd_buf: dcmd buffer.
+@@ -387,6 +389,8 @@
+ 	bool ibss_starter;
+ 	bool pwr_save;
+ 	bool dongle_up;
++	bool tx_power_set;
++	u32 tx_power_qdbm;
+ 	bool scan_tried;
+ 	u8 *dcmd_buf;
+ 	u8 *extra_buf;
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+@@ -2682,6 +2682,25 @@
+ 	return err;
+ }
+ 
++static s32 brcmf_apply_tx_power(struct brcmf_if *ifp, u32 qdbm)
++{
++	struct brcmf_pub *drvr = ifp->drvr;
++	s32 disable;
++	s32 err;
++
++	/* Make sure radio is off or on as far as software is concerned */
++	disable = WL_RADIO_SW_DISABLE << 16;
++	err = brcmf_fil_cmd_int_set(ifp, BRCMF_C_SET_RADIO, disable);
++	if (err)
++		bphy_err(drvr, "WLC_SET_RADIO error (%d)\n", err);
++
++	err = brcmf_fil_iovar_int_set(ifp, "qtxpower", qdbm);
++	if (err)
++		bphy_err(drvr, "qtxpower error (%d)\n", err);
++
++	return err;
++}
++
+ static s32
+ brcmf_cfg80211_set_tx_power(struct wiphy *wiphy, struct wireless_dev *wdev,
+ 			    int radio_idx, enum nl80211_tx_power_setting type,
+@@ -2692,12 +2711,9 @@
+ 	struct brcmf_if *ifp = netdev_priv(ndev);
+ 	struct brcmf_pub *drvr = cfg->pub;
+ 	s32 err;
+-	s32 disable;
+ 	u32 qdbm = 127;
+ 
+ 	brcmf_dbg(TRACE, "Enter %d %d\n", type, mbm);
+-	if (!check_vif_up(ifp->vif))
+-		return -EIO;
+ 
+ 	switch (type) {
+ 	case NL80211_TX_POWER_AUTOMATIC:
+@@ -2719,15 +2735,13 @@
+ 		err = -EINVAL;
+ 		goto done;
+ 	}
+-	/* Make sure radio is off or on as far as software is concerned */
+-	disable = WL_RADIO_SW_DISABLE << 16;
+-	err = brcmf_fil_cmd_int_set(ifp, BRCMF_C_SET_RADIO, disable);
+-	if (err)
+-		bphy_err(drvr, "WLC_SET_RADIO error (%d)\n", err);
+-
+-	err = brcmf_fil_iovar_int_set(ifp, "qtxpower", qdbm);
+-	if (err)
+-		bphy_err(drvr, "qtxpower error (%d)\n", err);
++	cfg->tx_power_qdbm = qdbm;
++	cfg->tx_power_set = true;
++	if (!check_vif_up(ifp->vif)) {
++		err = 0;
++		goto done;
++	}
++	err = brcmf_apply_tx_power(ifp, qdbm);
+ 
+ done:
+ 	brcmf_dbg(TRACE, "Exit %d (qdbm)\n", qdbm & ~WL_TXPWR_OVERRIDE);
+@@ -7903,9 +7917,16 @@
+ 
+ static s32 __brcmf_cfg80211_up(struct brcmf_if *ifp)
+ {
++	struct brcmf_cfg80211_info *cfg = ifp->drvr->config;
++	s32 err;
++
+ 	set_bit(BRCMF_VIF_STATUS_READY, &ifp->vif->sme_state);
+ 
+-	return brcmf_config_dongle(ifp->drvr->config);
++	err = brcmf_config_dongle(cfg);
++	if (!err && cfg->tx_power_set && !ifp->ifidx)
++		brcmf_apply_tx_power(ifp, cfg->tx_power_qdbm);
++
++	return err;
+ }
+ 
+ static s32 __brcmf_cfg80211_down(struct brcmf_if *ifp)
