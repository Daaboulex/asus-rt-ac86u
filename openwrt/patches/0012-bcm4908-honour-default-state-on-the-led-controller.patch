diff --git a/target/linux/bcm4908/patches-6.18/096-leds-bcm63138-honour-default-state.patch b/target/linux/bcm4908/patches-6.18/096-leds-bcm63138-honour-default-state.patch
new file mode 100644
index 0000000..06ac39e
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/096-leds-bcm63138-honour-default-state.patch
@@ -0,0 +1,31 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] leds: bcm63138: honour default-state
+
+The driver registers every LED at brightness 0 and writes that to the
+hardware, so default-state from the device tree is ignored: a power
+LED described as on stays dark until user space sets it. Read
+default-state before registering: "on" starts at full brightness and
+"keep" takes the state the LED is in, from the software data register.
+
+---
+--- a/drivers/leds/blink/leds-bcm63138.c
++++ b/drivers/leds/blink/leds-bcm63138.c
+@@ -224,6 +224,18 @@
+ 
+ 	led->active_low = of_property_read_bool(np, "active-low");
+ 
++	switch (led_init_default_state_get(init_data.fwnode)) {
++	case LEDS_DEFSTATE_ON:
++		led->cdev.brightness = BCM63138_MAX_BRIGHTNESS;
++		break;
++	case LEDS_DEFSTATE_KEEP:
++		if (bcm63138_leds_read(leds, BCM63138_SW_DATA) & BIT(led->pin))
++			led->cdev.brightness = BCM63138_MAX_BRIGHTNESS;
++		break;
++	default:
++		break;
++	}
++
+ 	led->cdev.max_brightness = BCM63138_MAX_BRIGHTNESS;
+ 	led->cdev.brightness_set = bcm63138_leds_brightness_set;
+ 	led->cdev.blink_set = bcm63138_leds_blink_set;
