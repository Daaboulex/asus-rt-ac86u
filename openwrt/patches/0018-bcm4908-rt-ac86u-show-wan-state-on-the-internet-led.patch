diff --git a/target/linux/bcm4908/patches-6.18/100-arm64-dts-broadcom-bcmbca-rt-ac86u-light-the-red-wan-led-at-boot.patch b/target/linux/bcm4908/patches-6.18/100-arm64-dts-broadcom-bcmbca-rt-ac86u-light-the-red-wan-led-at-boot.patch
new file mode 100644
index 0000000..6ce7aed
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/100-arm64-dts-broadcom-bcmbca-rt-ac86u-light-the-red-wan-led-at-boot.patch
@@ -0,0 +1,18 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] arm64: dts: broadcom: bcmbca: rt-ac86u: light the red wan led at boot
+
+The vendor documents the red WAN LED as "no IP or no physical
+connection". Nothing is connected while the kernel boots, so the LED
+starts lit; userspace turns it off once the WAN interface is up.
+
+---
+--- a/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
++++ b/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
+@@ -167,6 +167,7 @@
+ 		reg = <0x14>;
+ 		function = LED_FUNCTION_WAN;
+ 		color = <LED_COLOR_ID_RED>;
++		default-state = "on";
+ 		active-low;
+ 		pinctrl-names = "default";
+ 		pinctrl-0 = <&pins_led_20_a>;
