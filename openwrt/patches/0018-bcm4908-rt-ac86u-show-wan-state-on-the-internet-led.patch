diff --git a/target/linux/bcm4908/base-files/etc/hotplug.d/iface/50-wan-leds b/target/linux/bcm4908/base-files/etc/hotplug.d/iface/50-wan-leds
new file mode 100644
index 0000000..8c058e4
--- /dev/null
+++ b/target/linux/bcm4908/base-files/etc/hotplug.d/iface/50-wan-leds
@@ -0,0 +1,23 @@
+[ "$INTERFACE" = wan ] || exit 0
+[ -e /var/run/leds-dark ] && exit 0
+
+red=/sys/class/leds/red:wan
+white=/sys/class/leds/white:wan
+[ -d "$red" ] && [ -d "$white" ] || exit 0
+
+status=$(ubus call network.interface.wan status 2>/dev/null)
+
+if [ "$(echo "$status" | jsonfilter -e '@.up')" = true ]; then
+	echo none > "$red/trigger"
+	echo 0 > "$red/brightness"
+	echo netdev > "$white/trigger"
+	echo "$status" | jsonfilter -e '@.device' > "$white/device_name"
+	echo 1 > "$white/link"
+	echo 1 > "$white/tx"
+	echo 1 > "$white/rx"
+else
+	echo none > "$white/trigger"
+	echo 0 > "$white/brightness"
+	echo none > "$red/trigger"
+	cat "$red/max_brightness" > "$red/brightness"
+fi
