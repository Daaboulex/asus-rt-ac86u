index 0000000..0aba5f2
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/098-arm64-dts-broadcom-bcmbca-rt-ac86u-free-misc3-for-crash-records.patch
@@ -0,0 +1,18 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] arm64: dts: broadcom: bcmbca: rt-ac86u: free misc3 for crash records
+
+misc3 is a 1 MiB partition the vendor firmware used and OpenWrt does
+not. Make it writable so mtdpstore can keep the last panic records
+there: the unit's RAM does not survive a reset, so a RAM log cannot.
+
+---
+--- a/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
++++ b/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
+@@ -239,7 +239,6 @@
+ 		partition@f600000 {
+ 			label = "misc3";
+ 			reg = <0xf600000 0x100000>;
+-			read-only;
+ 		};
+ 
+ 		partition@f700000 {
