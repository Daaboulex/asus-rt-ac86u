diff --git a/target/linux/bcm4908/patches-6.18/316-arm64-dts-broadcom-bcmbca-rt-ac86u-keep-crash-records-in-misc3.patch b/target/linux/bcm4908/patches-6.18/316-arm64-dts-broadcom-bcmbca-rt-ac86u-keep-crash-records-in-misc3.patch
new file mode 100644
index 0000000..ee78b28
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/316-arm64-dts-broadcom-bcmbca-rt-ac86u-keep-crash-records-in-misc3.patch
@@ -0,0 +1,30 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] arm64: dts: broadcom: bcmbca: rt-ac86u: keep crash records in misc3
+
+misc3 is a 1 MiB partition the vendor firmware used and OpenWrt does
+not. Make it writable and name it to mtdpstore on the board's command
+line, so the kernel keeps its last panic records there: the unit's RAM
+does not survive a reset, so a RAM log cannot. The same line makes a
+soft lockup, a hard lockup and a hung task panic, so the watchdog
+reboots the unit and the panic leaves a record.
+
+---
+--- a/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
++++ b/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
+@@ -18,7 +18,7 @@
+ 	};
+ 
+ 	chosen {
+-		bootargs = "earlycon=bcm63xx_uart,0xff800640 console=ttyS0,115200 swiotlb=noforce";
++		bootargs = "earlycon=bcm63xx_uart,0xff800640 console=ttyS0,115200 swiotlb=noforce pstore_blk.blkdev=misc3 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.hung_task_panic=1";
+ 	};
+ 
+ 	memory@0 {
+@@ -243,7 +243,6 @@
+ 		partition@f600000 {
+ 			label = "misc3";
+ 			reg = <0xf600000 0x100000>;
+-			read-only;
+ 		};
+ 
+ 		partition@f700000 {
