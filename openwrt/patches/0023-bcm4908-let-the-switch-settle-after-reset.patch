diff --git a/target/linux/bcm4908/patches-6.18/102-net-dsa-bcm_sf2-let-the-bcm4908-switch-settle-after-reset.patch b/target/linux/bcm4908/patches-6.18/102-net-dsa-bcm_sf2-let-the-bcm4908-switch-settle-after-reset.patch
new file mode 100644
index 0000000..ee5144b
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/102-net-dsa-bcm_sf2-let-the-bcm4908-switch-settle-after-reset.patch
@@ -0,0 +1,25 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] net: dsa: bcm_sf2: let the bcm4908 switch settle after reset
+
+On the BCM4908 the probe's first read of the switch's "reg" block,
+REG_CROSSBAR in bcm_sf2_crossbar_setup(), sometimes ends in a
+synchronous external abort (ESR 0x96000210) and a panic. It follows
+bcm_sf2_sw_rst() at once, which sets EN_CHIP_RST and returns as soon
+as the core block reports SOFTWARE_RESET clear.
+
+Sleep 20 ms after that reset on the BCM4908 before any register is
+touched.
+
+---
+--- a/drivers/net/dsa/bcm_sf2.c
++++ b/drivers/net/dsa/bcm_sf2.c
+@@ -502,6 +502,9 @@ static int bcm_sf2_sw_rst(struct bcm_sf2_priv *priv)
+ 	if (timeout == 0)
+ 		return -ETIMEDOUT;
+ 
++	if (priv->type == BCM4908_DEVICE_ID)
++		msleep(20);
++
+ 	return 0;
+ }
+ 
