diff --git a/package/kernel/mac80211/patches/brcm/882-wifi-brcmfmac-report-a-channel-survey-from-chanim_stats.patch b/package/kernel/mac80211/patches/brcm/882-wifi-brcmfmac-report-a-channel-survey-from-chanim_stats.patch
new file mode 100644
index 0000000..dd0a49b
--- /dev/null
+++ b/package/kernel/mac80211/patches/brcm/882-wifi-brcmfmac-report-a-channel-survey-from-chanim_stats.patch
@@ -0,0 +1,272 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] wifi: brcmfmac: report a channel survey from chanim_stats
+
+Router firmware for the BCM4366 family (10.28.2) has no dump_obss, so
+brcmfmac offers no survey and hostapd's automatic channel selection
+fails with "Unable to collect survey data". The same firmware keeps
+per-channel interference statistics, refreshed by every scan, behind
+the chanim_stats iovar: background noise, idle time and the split of
+busy time into own transmit, own BSS, other BSSs and non-802.11 noise.
+
+Probe chanim_stats at attach and, when the firmware answers with
+version 2 and dump_obss is absent, answer survey requests from it.
+Firmware 10.10.131.81 for the same chip answers with version 3 and the
+version 2 record unchanged, nine CCA counters in 36 bytes; take a
+version 3 reply when its length is exactly that record per channel.
+Each record is a percentage of its sample period, reported as time out
+of 100 ms. A record's background noise is the channel's noise; a
+record without one, read as 0 dBm, reports none.
+
+The firmware samples that noise during scan dwells together with the
+traffic, and on one 2.4 GHz channel it moved by up to 20 dB between
+scans (-60 to -82 dBm). hostapd weighs noise as 2^(noise - min_noise),
+so a single low reading can win the channel choice for a busy channel.
+
+---
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/cfg80211.c
+@@ -8212,6 +8212,90 @@
+ }
+ 
+ static int
++brcmf_cfg80211_dump_survey_chanim(struct wiphy *wiphy, struct net_device *ndev,
++				  int idx, struct survey_info *info)
++{
++	struct brcmf_cfg80211_info *cfg = wiphy_to_cfg(wiphy);
++	struct brcmf_if *ifp = netdev_priv(cfg_to_ndev(cfg));
++	struct brcmf_chanim_stats_list_le *list;
++	const struct brcmf_chanim_stats_le *rec;
++	struct ieee80211_supported_band *band;
++	enum nl80211_band band_id;
++	struct brcmu_chan ch;
++	size_t size;
++	u32 count, version, i;
++	u8 busy;
++	int err;
++
++	for (band_id = 0; band_id < NUM_NL80211_BANDS; band_id++) {
++		band = wiphy->bands[band_id];
++		if (!band)
++			continue;
++		if (idx >= band->n_channels) {
++			idx -= band->n_channels;
++			continue;
++		}
++		info->channel = &band->channels[idx];
++		break;
++	}
++	if (band_id == NUM_NL80211_BANDS)
++		return -ENOENT;
++
++	size = struct_size(list, stats, BRCMF_CHANIM_STATS_MAX);
++	list = kzalloc(size, GFP_KERNEL);
++	if (!list)
++		return -ENOMEM;
++
++	list->buflen = cpu_to_le32(size);
++	list->count = cpu_to_le32(BRCMF_CHANIM_COUNT_ALL);
++	err = brcmf_fil_iovar_data_get(ifp, "chanim_stats", list, size);
++	if (err)
++		goto exit;
++
++	version = le32_to_cpu(list->version);
++	if ((version != BRCMF_CHANIM_STATS_VERSION_2 &&
++	     version != BRCMF_CHANIM_STATS_VERSION_3) ||
++	    struct_size(list, stats, le32_to_cpu(list->count)) > size) {
++		err = -EOPNOTSUPP;
++		goto exit;
++	}
++
++	info->filled = 0;
++	count = min_t(u32, le32_to_cpu(list->count), BRCMF_CHANIM_STATS_MAX);
++	for (i = 0; i < count; i++) {
++		rec = &list->stats[i];
++		ch.chspec = le16_to_cpu(rec->chanspec);
++		cfg->d11inf.decchspec(&ch);
++		if (ch.control_ch_num != info->channel->hw_value)
++			continue;
++		if ((ch.band == BRCMU_CHAN_BAND_2G) !=
++		    (band_id == NL80211_BAND_2GHZ))
++			continue;
++
++		busy = BRCMF_CHANIM_PERCENT -
++		       min_t(u8, rec->chan_idle, BRCMF_CHANIM_PERCENT);
++		info->time = BRCMF_CHANIM_PERCENT;
++		info->time_busy = busy;
++		info->time_tx = rec->ccastats[BRCMF_CCASTATS_TXDUR];
++		info->time_rx = rec->ccastats[BRCMF_CCASTATS_INBSS] +
++				rec->ccastats[BRCMF_CCASTATS_OBSS] +
++				rec->ccastats[BRCMF_CCASTATS_NOCTG] +
++				rec->ccastats[BRCMF_CCASTATS_NOPKT];
++		info->filled = SURVEY_INFO_TIME | SURVEY_INFO_TIME_BUSY |
++			       SURVEY_INFO_TIME_RX | SURVEY_INFO_TIME_TX;
++		if (rec->bgnoise < 0) {
++			info->noise = rec->bgnoise;
++			info->filled |= SURVEY_INFO_NOISE_DBM;
++		}
++		break;
++	}
++
++exit:
++	kfree(list);
++	return err;
++}
++
++static int
+ brcmf_cfg80211_dump_survey(struct wiphy *wiphy, struct net_device *ndev,
+ 			   int idx, struct survey_info *info)
+ {
+@@ -8476,6 +8560,8 @@
+ #if !defined(CONFIG_ARCH_BCM2835)
+ 	if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_DUMP_OBSS))
+ 		ops->dump_survey = brcmf_cfg80211_dump_survey;
++	else if (brcmf_feat_is_enabled(ifp, BRCMF_FEAT_CHANIM_STATS))
++		ops->dump_survey = brcmf_cfg80211_dump_survey_chanim;
+ #endif /* CONFIG_ARCH_BCM2835 */
+ 
+ 	err = wiphy_register(wiphy);
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/feature.c
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/feature.c
+@@ -203,6 +203,48 @@
+ 	ifp->fwil_fwerr = false;
+ }
+ 
++static bool
++brcmf_feat_chanim_stats_layout(const struct brcmf_chanim_stats_list_le *list)
++{
++	u32 count = le32_to_cpu(list->count);
++
++	switch (le32_to_cpu(list->version)) {
++	case BRCMF_CHANIM_STATS_VERSION_2:
++		return true;
++	case BRCMF_CHANIM_STATS_VERSION_3:
++		return le32_to_cpu(list->buflen) ==
++		       struct_size(list, stats, count);
++	default:
++		return false;
++	}
++}
++
++static void brcmf_feat_chanim_stats(struct brcmf_if *ifp)
++{
++	struct brcmf_chanim_stats_list_le *req;
++	size_t size = struct_size(req, stats, 1);
++	int err;
++
++	req = kzalloc(size, GFP_KERNEL);
++	if (!req)
++		return;
++
++	req->buflen = cpu_to_le32(size);
++	req->count = cpu_to_le32(BRCMF_CHANIM_COUNT_ONE);
++	err = brcmf_fil_iovar_data_get(ifp, "chanim_stats", req, size);
++	if (!err && !brcmf_feat_chanim_stats_layout(req))
++		err = -EOPNOTSUPP;
++	if (err) {
++		brcmf_dbg(TRACE, "chanim_stats feature check failed: %d\n", err);
++		kfree(req);
++		return;
++	}
++
++	kfree(req);
++	brcmf_dbg(INFO, "enabling feature: CHANIM_STATS\n");
++	ifp->drvr->feat_flags |= BIT(BRCMF_FEAT_CHANIM_STATS);
++}
++
+ static void brcmf_feat_iovar_data_set(struct brcmf_if *ifp,
+ 				      enum brcmf_feat_id id, char *name,
+ 				      const void *data, size_t len)
+@@ -331,6 +373,7 @@
+ 	brcmf_feat_iovar_int_get(ifp, BRCMF_FEAT_TDLS, "tdls_enable");
+ 	brcmf_feat_iovar_int_get(ifp, BRCMF_FEAT_MFP, "mfp");
+ 	brcmf_feat_iovar_int_get(ifp, BRCMF_FEAT_DUMP_OBSS, "dump_obss");
++	brcmf_feat_chanim_stats(ifp);
+ 
+ 	pfn_mac.version = BRCMF_PFN_MACADDR_CFG_VER;
+ 	err = brcmf_fil_iovar_data_get(ifp, "pfn_macaddr", &pfn_mac,
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/feature.h
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/feature.h
+@@ -30,6 +30,7 @@
+  * SAE: simultaneous authentication of equals
+  * FWAUTH: Firmware authenticator
+  * DUMP_OBSS: Firmware has capable to dump obss info to support ACS
++ * CHANIM_STATS: Firmware reports per-channel interference statistics
+  * SCAN_V2: Version 2 scan params
+  * SAE_EXT: SAE authentication handled by user-space supplicant
+  */
+@@ -56,6 +57,7 @@
+ 	BRCMF_FEAT_DEF(SAE) \
+ 	BRCMF_FEAT_DEF(FWAUTH) \
+ 	BRCMF_FEAT_DEF(DUMP_OBSS) \
++	BRCMF_FEAT_DEF(CHANIM_STATS) \
+ 	BRCMF_FEAT_DEF(SCAN_V2) \
+ 	BRCMF_FEAT_DEF(PMKID_V2) \
+ 	BRCMF_FEAT_DEF(PMKID_V3) \
+--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil_types.h
++++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/fwil_types.h
+@@ -1236,4 +1236,65 @@
+ 	u8   data[];
+ } __packed;
+ 
++#define BRCMF_CHANIM_STATS_VERSION_2	2
++#define BRCMF_CHANIM_STATS_VERSION_3	3
++#define BRCMF_CHANIM_COUNT_ALL		0xff
++#define BRCMF_CHANIM_COUNT_ONE		0x1
++#define BRCMF_CHANIM_STATS_MAX		64
++#define BRCMF_CHANIM_PERCENT		100
++
++enum brcmf_ccastats {
++	BRCMF_CCASTATS_TXDUR,
++	BRCMF_CCASTATS_INBSS,
++	BRCMF_CCASTATS_OBSS,
++	BRCMF_CCASTATS_NOCTG,
++	BRCMF_CCASTATS_NOPKT,
++	BRCMF_CCASTATS_DOZE,
++	BRCMF_CCASTATS_TXOP,
++	BRCMF_CCASTATS_GDTXDUR,
++	BRCMF_CCASTATS_BDTXDUR,
++	BRCMF_CCASTATS_MAX
++};
++
++/**
++ * struct brcmf_chanim_stats_le - interference statistics of one channel
++ *
++ * @glitchcnt: OFDM glitches per second.
++ * @badplcp: OFDM bad PLCP headers per second.
++ * @ccastats: share of the sample period per &enum brcmf_ccastats, in percent.
++ * @bgnoise: background noise in dBm.
++ * @chanspec: channel the record describes.
++ * @timestamp: firmware time of the sample.
++ * @bphy_glitchcnt: CCK glitches per second.
++ * @bphy_badplcp: CCK bad PLCP headers per second.
++ * @chan_idle: share of the sample period the channel was idle, in percent.
++ */
++struct brcmf_chanim_stats_le {
++	__le32 glitchcnt;
++	__le32 badplcp;
++	u8 ccastats[BRCMF_CCASTATS_MAX];
++	s8 bgnoise;
++	__le16 chanspec;
++	__le32 timestamp;
++	__le32 bphy_glitchcnt;
++	__le32 bphy_badplcp;
++	u8 chan_idle;
++};
++
++/**
++ * struct brcmf_chanim_stats_list_le - reply of the chanim_stats iovar
++ *
++ * @buflen: size of the request buffer, then of the reply.
++ * @version: layout version, %BRCMF_CHANIM_STATS_VERSION_2, or
++ *	%BRCMF_CHANIM_STATS_VERSION_3 with the same record.
++ * @count: records requested (%BRCMF_CHANIM_COUNT_ALL), then returned.
++ * @stats: one record per channel the firmware has sampled.
++ */
++struct brcmf_chanim_stats_list_le {
++	__le32 buflen;
++	__le32 version;
++	__le32 count;
++	struct brcmf_chanim_stats_le stats[];
++};
++
+ #endif /* FWIL_TYPES_H_ */
