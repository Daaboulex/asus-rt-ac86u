diff --git a/target/linux/bcm4908/patches-6.18/315-arm64-dts-broadcom-bcmbca-rt-ac86u-fence-the-radios-DMA.patch b/target/linux/bcm4908/patches-6.18/315-arm64-dts-broadcom-bcmbca-rt-ac86u-fence-the-radios-DMA.patch
new file mode 100644
index 0000000..5f70c82
--- /dev/null
+++ b/target/linux/bcm4908/patches-6.18/315-arm64-dts-broadcom-bcmbca-rt-ac86u-fence-the-radios-DMA.patch
@@ -0,0 +1,71 @@
+From: Daaboulex <39669593+Daaboulex@users.noreply.github.com>
+Subject: [PATCH] arm64: dts: broadcom: bcmbca: rt-ac86u: fence the radios DMA
+
+The radios run closed firmware with bus mastering on PCIe, and the
+BCM4908 has no IOMMU, so each could read and write all of RAM through
+its inbound window. Give each link its own 32 MiB restricted DMA pool
+at the top of RAM and shrink its inbound window to exactly that pool:
+the kernel bounces every radio buffer through it, and neither radio
+reaches the rest of memory or the other radio's buffers.
+
+Each window maps its pool at the pool's own address. A pool seen at
+PCI address 0 hands its first buffer out at bus address 0, and the
+radio given that buffer never answered its first command.
+
+The narrower window ends the kernel's DMA zone at 0x1e000000, below
+the top of RAM, so the kernel sets aside a 64 MiB default bounce
+buffer, and MemTotal falls from 436784 kB to 370476 kB. No device
+here uses it: the radios bounce through their own pools and every
+other device reaches all of RAM. Turn it off with swiotlb=noforce on
+the board's command line, which replaces the target's and so repeats
+its earlycon and console.
+
+---
+--- a/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
++++ b/arch/arm64/boot/dts/broadcom/bcmbca/bcm4906-asus-rt-ac86u.dts
+@@ -17,11 +17,27 @@
+ 		led-upgrade = &led_power;
+ 	};
+ 
++	chosen {
++		bootargs = "earlycon=bcm63xx_uart,0xff800640 console=ttyS0,115200 swiotlb=noforce";
++	};
++
+ 	memory@0 {
+ 		device_type = "memory";
+ 		reg = <0x00 0x00 0x00 0x20000000>;
+ 	};
+ 
++	reserved-memory {
++		radio0_dma: wifi@1c000000 {
++			compatible = "restricted-dma-pool";
++			reg = <0x00 0x1c000000 0x00 0x2000000>;
++		};
++
++		radio1_dma: wifi@1e000000 {
++			compatible = "restricted-dma-pool";
++			reg = <0x00 0x1e000000 0x00 0x2000000>;
++		};
++	};
++
+ 	gpio-keys-polled {
+ 		compatible = "gpio-keys-polled";
+ 		poll-interval = <20>;
+@@ -239,13 +255,15 @@
+ };
+ 
+ &pcie0 {
+-	dma-ranges = <0x02000000 0x00 0x00000000 0x00000000 0x00 0x20000000>;
++	memory-region = <&radio0_dma>;
++	dma-ranges = <0x02000000 0x00 0x1c000000 0x1c000000 0x00 0x2000000>;
+ 	brcm,enable-ssc;
+ 	status = "okay";
+ };
+ 
+ &pcie1 {
+-	dma-ranges = <0x02000000 0x00 0x00000000 0x00000000 0x00 0x20000000>;
++	memory-region = <&radio1_dma>;
++	dma-ranges = <0x02000000 0x00 0x1e000000 0x1e000000 0x00 0x2000000>;
+ 	brcm,enable-ssc;
+ 	status = "okay";
+ };
