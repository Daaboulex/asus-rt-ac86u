--- a/target/linux/bcm4908/config-6.18
+++ b/target/linux/bcm4908/config-6.18
@@ -86,6 +86,7 @@ CONFIG_DEBUG_INFO=y
 CONFIG_DMA_BOUNCE_UNALIGNED_KMALLOC=y
